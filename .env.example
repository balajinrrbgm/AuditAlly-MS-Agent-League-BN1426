# ──────────────────────────────────────────────────────────────────────────
# AuditAlly configuration — copy to ".env" and fill in. NEVER commit ".env".
# Everything below is OPTIONAL. With NO values set, AuditAlly runs fully
# OFFLINE with deterministic synthetic data (perfect for judging/demo).
# ──────────────────────────────────────────────────────────────────────────

# --- Server ---
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787

# --- Microsoft Entra ID (OAuth 2.0 for the MCP server) ---
# When set, the HTTP MCP server validates incoming Bearer tokens against Entra.
# Leave blank to run in "dev token" mode (a static demo token) for local testing.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
# Comma-separated scopes the agent must present (least privilege).
ENTRA_REQUIRED_SCOPES=AuditAlly.Read,AuditAlly.Write

# --- Foundry IQ (Azure AI Search agentic retrieval) ---
# When set, grounding uses live Azure AI Search instead of the offline index.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=auditally-knowledge

# --- Azure OpenAI (optional — for live answer synthesis) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
